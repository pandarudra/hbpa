rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: readable by the owner; all writes go through the backend Admin SDK.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Admin SDK bypasses these rules
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
