# ════════════════════════════════════════════════════════════════
#  SERVER — Node.js / Express backend
#  Copy this file to backend/.env  (never commit .env)
# ════════════════════════════════════════════════════════════════

# ── Allowed email domains ─────────────────────────────────────────
# Comma-separated list of EXACT domains (no wildcards).
# Subdomains are NOT matched unless listed explicitly.
# Examples:
#   One domain:    hbplus.fit
#   Many domains:  hbplus.fit,acme.com,partner.org
ALLOWED_EMAIL_DOMAINS=

# ── Session ───────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters.
SESSION_SECRET=
# Session lifetime in seconds  (default: 28800 = 8 hours)
SESSION_MAX_AGE=28800

# ── Firebase Admin SDK ────────────────────────────────────────────
# How to get: Firebase Console → Project Settings → Service Accounts
#             → Generate new private key → download JSON
#
# Option A (recommended for local dev): path to the JSON file you downloaded
GOOGLE_APPLICATION_CREDENTIALS=
#
# Option B (recommended for containers/cloud): paste the entire JSON,
# base64-encoded:  base64 -w 0 service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project ID — must match EXPO_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=
GOOGLE_WEB_CLIENT_ID=

# ── Server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:   http://localhost:8081,http://localhost:19006
# Production:  https://app.yourdomain.com
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
