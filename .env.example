# ════════════════════════════════════════════════════════════════
#  CLIENT — Expo / React Native
#  Copy this file to .env  (never commit .env)
# ════════════════════════════════════════════════════════════════

# ── Google OAuth Client IDs ──────────────────────────────────────
# How to get: Google Cloud Console → APIs & Services → Credentials
# → Create Credential → OAuth 2.0 Client ID

# Web client  (type: Web application)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android client  (type: Android)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# iOS client  (type: iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Firebase (public — these are safe in the client bundle) ──────
# How to get: Firebase Console → Project Settings → General
#             → Your apps → Web app → Config object

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# ── Backend URL ──────────────────────────────────────────────────
# Local dev:         http://localhost:4000
# Android emulator:  http://10.0.2.2:4000
# Production:        https://api.yourdomain.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
